{
  "name": "zcode-token-usage-statusbar",
  "version": "1.5.26",
  "description": "ZCode token usage query via the token_usage MCP tool, /usage command, and skill (reads the local usage DB). Auto-installs the desktop floating usage status bar whenever the client is not injected (always on; legacy auto-install config keys are no longer read; /uninstall-overlay blocks re-injection; modifies app.asar - fully quit and reopen ZCode to take effect). Appends a per-answer rate line at the end of each reply (rendered deterministically via the renderer bridge; tok/s, TTFT, output tokens).",
  "author": {
    "name": "xhwxt/ByteRax"
  },
  "homepage": "https://github.com/ByteRax/zcode-token-usage-statusbar",
  "repository": "https://github.com/ByteRax/zcode-token-usage-statusbar",
  "license": "MIT",
  "keywords": [
    "token",
    "usage",
    "statusbar",
    "monitor",
    "zusage"
  ],
  "commands": "commands",
  "skills": "skills",
  "extension": {
    "engines": {
      "zcode": "^1.0.0"
    },
    "main": "./extension-main.cjs",
    "activationEvents": [
      "onAvailable"
    ],
    "contributes": {
      "commands": [
        {
          "id": "open-insights",
          "title": {
            "zh-CN": "打开上下文洞察",
            "en-US": "Open context insights"
          }
        },
        {
          "id": "open-context",
          "title": {
            "zh-CN": "打开上下文组成",
            "en-US": "Open context dashboard"
          }
        }
      ],
      "views": [
        {
          "id": "insights",
          "title": {
            "zh-CN": "上下文洞察",
            "en-US": "Context Insights"
          },
          "icon": "bar-chart-2",
          "scope": "app"
        },
        {
          "id": "context",
          "title": {
            "zh-CN": "上下文组成",
            "en-US": "Context"
          },
          "icon": "pie-chart"
        }
      ]
    }
  },
  "slots": {
    "nav.primary": [
      {
        "id": "insights",
        "icon": "bar-chart-2",
        "title": {
          "zh-CN": "上下文洞察",
          "en-US": "Context Insights"
        },
        "target": {
          "view": "insights"
        }
      }
    ],
    "sidePane.launcher": [
      {
        "id": "open-context",
        "icon": "pie-chart",
        "title": {
          "zh-CN": "上下文组成",
          "en-US": "Context"
        },
        "target": {
          "view": "context"
        }
      }
    ]
  },
  "packageLayout": {
    "schemaVersion": 1,
    "files": [
      "LICENSE",
      "marketplace.json",
      "plugins/zcode-token-usage-statusbar/.claude-plugin/plugin.json",
      "plugins/zcode-token-usage-statusbar/.mcp.json",
      "plugins/zcode-token-usage-statusbar/.zcode-plugin/plugin.json",
      "plugins/zcode-token-usage-statusbar/README.md",
      "plugins/zcode-token-usage-statusbar/commands/context.md",
      "plugins/zcode-token-usage-statusbar/commands/install-overlay.md",
      "plugins/zcode-token-usage-statusbar/commands/uninstall-overlay.md",
      "plugins/zcode-token-usage-statusbar/commands/zusage-doctor.md",
      "plugins/zcode-token-usage-statusbar/commands/usage.md",
      "plugins/zcode-token-usage-statusbar/engine-patch.cjs",
      "plugins/zcode-token-usage-statusbar/extension-main.cjs",
      "plugins/zcode-token-usage-statusbar/extension-view-context.js",
      "plugins/zcode-token-usage-statusbar/extension-view-insights.js",
      "plugins/zcode-token-usage-statusbar/mobile-relay.cjs",
      "plugins/zcode-token-usage-statusbar/hooks/hooks.json",
      "plugins/zcode-token-usage-statusbar/hooks/prompt-submit.py",
      "plugins/zcode-token-usage-statusbar/hooks/session-start.py",
      "plugins/zcode-token-usage-statusbar/inject-main.cjs",
      "plugins/zcode-token-usage-statusbar/install_monitor.py",
      "plugins/zcode-token-usage-statusbar/overlay.js",
      "plugins/zcode-token-usage-statusbar/overlay_install.py",
      "plugins/zcode-token-usage-statusbar/patch_install.py",
      "plugins/zcode-token-usage-statusbar/pending_zip_patch.py",
      "plugins/zcode-token-usage-statusbar/plugin-release.cjs",
      "plugins/zcode-token-usage-statusbar/plugin-storage.cjs",
      "plugins/zcode-token-usage-statusbar/plugin-updater.cjs",
      "plugins/zcode-token-usage-statusbar/sysmon-client.cjs",
      "plugins/zcode-token-usage-statusbar/plugin_auto_update.py",
      "plugins/zcode-token-usage-statusbar/quota-client.cjs",
      "plugins/zcode-token-usage-statusbar/model-puller.cjs",
      "plugins/zcode-token-usage-statusbar/release_unpack.py",
      "plugins/zcode-token-usage-statusbar/renderer_bridge.py",
      "plugins/zcode-token-usage-statusbar/restart_notice.py",
      "plugins/zcode-token-usage-statusbar/runtime_lock.py",
      "plugins/zcode-token-usage-statusbar/skills/zcode-token-usage/SKILL.md",
      "plugins/zcode-token-usage-statusbar/token_pricing.py",
      "plugins/zcode-token-usage-statusbar/token_rate.py",
      "plugins/zcode-token-usage-statusbar/turn-stats.js",
      "plugins/zcode-token-usage-statusbar/usage_mcp.py",
      "plugins/zcode-token-usage-statusbar/usage_stats.py",
      "plugins/zcode-token-usage-statusbar/zusage.py"
    ]
  },
  "description_i18n": {
    "en": "ZCode token usage query via the token_usage MCP tool, /usage command, and skill (reads the local usage DB). Auto-installs the desktop floating usage status bar whenever the client is not injected (always on; legacy auto-install config keys are no longer read; /uninstall-overlay blocks re-injection; modifies app.asar - fully quit and reopen ZCode to take effect). Appends a per-answer rate line at the end of each reply (rendered deterministically via the renderer bridge; tok/s, TTFT, output tokens).",
    "zh-CN": "ZCode token 用量查询（token_usage MCP 工具 + /usage 命令 + 技能，读本地 usage 数据库）；桌面客户端未注入时始终尝试自动安装/修复悬浮用量状态条（修改 app.asar，成功后需完全退出并重开；旧自动安装开关不再生效，/uninstall-overlay 可阻止自动重注入）；每次回答末尾自动追加逐问速率行（由前端确定性渲染，依赖 renderer 桥；即时 tok/s 含思考、首字延迟、输出 token、生成耗时、段数/峰值与会话累计，--current 守卫防旧数据充数）。"
  }
}
