{
  "name": "deckcraft",
  "version": "0.2.4",
  "description": "DeckCraft presentations in a ZCode panel, with workspace file opening and host-mediated exports.",
  "description_i18n": {
    "en": "DeckCraft presentations in a ZCode panel, with workspace file opening and host-mediated exports.",
    "zh-CN": "在 ZCode 面板中使用 DeckCraft 进行演示文稿，支持打开工作区文件和通过宿主保存导出。"
  },
  "author": {
    "name": "zcoder"
  },
  "license": "MIT OR Apache-2.0",
  "commands": "commands",
  "mcpServers": {
    "deckcraft": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/dist/server.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "DeckCraft",
          "zh-CN": "DeckCraft"
        },
        "icon": "presentation",
        "server": "deckcraft",
        "resourceUri": "ui://deckcraft/panel.html",
        "availability": "session"
      }
    ]
  }
}
