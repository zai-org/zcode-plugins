{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/advisor-hook.mjs", "SessionStart"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/advisor-hook.mjs", "UserPromptSubmit"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|ApplyPatch)$",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/advisor-hook.mjs", "PreToolUse"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|ApplyPatch|Agent|Task)$",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/advisor-hook.mjs", "PostToolUse"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/advisor-hook.mjs", "PostToolUseFailure"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/scripts/advisor-hook.mjs", "Stop"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
