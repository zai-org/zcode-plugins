"""HTTP surface for {{PROJECT}}.

Standard library only: the scaffold must run before you pick a framework.
Replace the handler, keep `health()` real, and let `galadon check` stay green.
"""

from __future__ import annotations

import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any

from . import __version__

PROJECT = "{{PROJECT}}"


def health() -> dict[str, Any]:
    return {"ok": True, "project": PROJECT, "version": __version__}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802
        if self.path != "/health.json":
            self.send_error(404, "not found")
            return
        body = json.dumps(health()).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt: str, *args: Any) -> None:
        return


def main() -> None:
    host = os.environ.get("HOST", "127.0.0.1")
    port = int(os.environ.get("PORT", "8000"))
    server = ThreadingHTTPServer((host, port), Handler)
    print(f"{PROJECT} listening on http://{host}:{port}")
    server.serve_forever()


if __name__ == "__main__":
    main()
