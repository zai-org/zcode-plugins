from __future__ import annotations

import io
import json
import os
import subprocess
import sys
import unittest
from contextlib import redirect_stdout
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from {{PACKAGE}}.cli import main  # noqa: E402


class CliTests(unittest.TestCase):
    def test_ping_json_names_the_plugin(self) -> None:
        buffer = io.StringIO()
        with redirect_stdout(buffer):
            code = main(["ping", "--json"])
        self.assertEqual(code, 0)
        self.assertEqual(
            json.loads(buffer.getvalue()),
            {"ok": True, "plugin": "{{NPM_NAME}}", "version": "0.1.0"},
        )

    def test_module_entrypoint_prints_version(self) -> None:
        env = {**os.environ, "PYTHONPATH": str(ROOT / "src")}
        proc = subprocess.run(
            [sys.executable, "-m", "{{PACKAGE}}", "--version"],
            capture_output=True,
            text=True,
            env=env,
        )
        self.assertEqual(proc.returncode, 0, proc.stderr)
        self.assertEqual(proc.stdout.strip(), "{{NPM_NAME}} 0.1.0")


if __name__ == "__main__":
    unittest.main()
