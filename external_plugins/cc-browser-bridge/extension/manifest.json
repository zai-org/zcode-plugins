{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.2.1",
  "description": "让 ZCode 等兼容客户端中的 AI 查看和操作你正在使用的 Chrome：读网页/标签页、截图、点击、填写（保留登录态）",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["debugger", "tabs", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "ws://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
