{
  "name": "excalidraw",
  "version": "0.3.4",
  "description": "让 Agent 生成图形，在对话侧栏用 Excalidraw 编辑、引用选区、继续修改并导出。",
  "author": {
    "name": "zcoder"
  },
  "license": "MIT",
  "skills": "skills",
  "mcpServers": {
    "excalidraw": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/dist/server.mjs"],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "excalidraw",
        "title": {
          "zh-CN": "Excalidraw 画板",
          "en-US": "Excalidraw"
        },
        "icon": "pencil",
        "server": "excalidraw",
        "resourceUri": "ui://excalidraw/panel.html",
        "availability": "session"
      }
    ]
  },
  "description_i18n": {
    "en": "Create and edit diagrams with Excalidraw and MCP tools.",
    "zh-CN": "让 Agent 生成图形，在对话侧栏用 Excalidraw 编辑、引用选区、继续修改并导出。"
  }
}
