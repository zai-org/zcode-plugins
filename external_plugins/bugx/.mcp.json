{
  "mcpServers": {
    "bugx": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--quiet",
        "bugx-cli",
        "mcp",
        "serve",
        "--root",
        "${ZCODE_PROJECT_DIR}"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "timeoutMs": 120000
    }
  }
}
