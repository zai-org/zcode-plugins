{
  "description": "Tripo 3D: inject the hard rules for Tripo tool use at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "tripo-3d: loading Tripo rules…"
          }
        ]
      }
    ]
  }
}
