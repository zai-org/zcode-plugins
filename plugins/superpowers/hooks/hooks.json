{
  "description": "Superpowers skills bootstrap for ZCode sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 5000,
            "statusMessage": "superpowers: loading skills bootstrap…"
          }
        ]
      }
    ]
  }
}
