# video-agent-kit configuration reference. Copy entries into either:
#   <plugin_root>/.env   - kit-wide defaults (loaded first), or
#   <project_dir>/.env   - per-project overrides.
# Precedence: process environment > project .env > plugin .env.
# Do not put real secrets in this example file.

# ASR provider selection for the transcribe tool: auto / asr.
# auto (default) is a compatibility alias for asr.
# VE_ASR_PROVIDER=auto

# Recognition runs on the signed-in ZCode account (audio is uploaded, then recognised); no key is needed.

# --- TTS: preset voices (tts_generate, synthesize_narration, produce_film) ---
# Synthesis runs on the signed-in ZCode account; no key is needed.
# Default preset voice id; characters use one fixed preset voice id for all their lines.
# VE_TTS_VOICE=zixinnansheng
# Movie narration overrides (explicit tool arguments take precedence).
# VE_NARRATION_TTS_RATE=+0%
# VE_TTS_STYLE_DEFAULT=

# --- Runtime ---
# Project directory. Outputs go to <project>/out and <project>/.video_agent.
# VE_PROJECT_DIR takes precedence; otherwise hooks use the event's cwd and tools their working directory.
# VE_PROJECT_DIR=/path/to/project

# Maximum active long MCP jobs per project (background threads of the MCP server).
# VE_MCP_WORKERS=2
# Seconds a long tool call waits for a free job slot before failing.
# VE_MCP_QUEUE_SECONDS=120

# Hook state directory. Injected by ZCode (plugin data directory); falls back to
# <project>/.video_agent/hook_state when unset.
# ZCODE_PLUGIN_DATA=

# --- Video understanding ---
# Per-call observation sampling limit and frame width.
# VE_OBSERVE_MAX_FRAMES=64
# VE_OBSERVE_FRAME_WIDTH=512
# MCP image return count and byte budget; omitted evidence is reported.
# VE_MAX_INLINE_IMAGES=64
# VE_MAX_INLINE_IMAGE_BYTES=16777216
# Full remote-video cache (outside the exported workspace by default).
# VE_VIDEOSITES_MEDIA_DIR=/tmp/video_agent_media
# Optional source-site user agent for public API requests.
# VE_VIDEOSITES_WM_UA=video-agent-kit/0.4

# Subtitle/title fonts: directories containing .ttf/.ttc/.otf, separated by OS path separator.
VE_FONT_DIRS=

# Creation: images come from the ZCode image generator through the signed-in ZCode account (no key).
# Videos come from the ZCode video generator through the same account (no key).
VE_VIDEO_GENERATOR=video-v2.5
# Optional explicit directory containing det_10g.onnx and w600k_r50.onnx
VE_FACEQC_DIR=
# Voice-card check (creation): VE_SPEAKER_SCORER = campp (default) | resemblyzer | mfcc_f0.
# campp reads a mounted ONNX graph from VE_SPEAKER_MODELS_DIR (default /opt/video_edit_models)
# when there is one; otherwise ModelScope's CAM++ weights (iic/speech_campplus_sv_zh-cn_16k-common),
# downloaded once on first use into <VE_STATE_HOME or ~/.video_agent>/models. Nothing to install.
VE_SPEAKER_SCORER=
VE_SPEAKER_MODELS_DIR=
# Optional: a local campplus_cn_common.bin instead of the download, or a ModelScope mirror.
VE_SPEAKER_CAMPP_WEIGHTS=
VE_MODELSCOPE_ENDPOINT=

# --- Movie recap ---
# Background-music library for video_render kind=narrated (<emotion>/*.mp3).
# VE_BGM_DIR=
# Frame-refinement workers for detect_shots.
# VE_SHOT_REFINE_WORKERS=
# Movie recap text and picture checks are done by subagents of the running
# session; they inherit the main model and need no review credentials.
# Shared directory for cross-container media job slots (ffmpeg/TTS concurrency).
# The host mounts it for movie runs; defaults to a directory under the project.
# VE_RECAP_BUDGET_DIR=
