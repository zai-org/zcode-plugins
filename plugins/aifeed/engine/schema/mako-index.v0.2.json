{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifeed.md/schema/mako-index/v0.2.json",
  "title": "AIFeed MAKO Delta Index v0.2",
  "type": "object",
  "required": ["version", "domain", "generated_at", "page", "page_count", "entries"],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "version": {
      "const": "0.2"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "enum": ["ecommerce", "news", "education", "government", "saas", "portfolio", "community", "docs", "nonprofit", "personal", "blog", "media", "marketplace", "other"]
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        },
        "license": {
          "type": "string",
          "maxLength": 256
        },
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": ["url", "type", "tokens", "updated", "etag", "sha-256"],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^/\\S*$",
            "maxLength": 2048
          },
          "type": {
            "enum": ["product", "article", "docs", "landing", "profile", "listing", "event", "recipe", "faq", "custom"]
          },
          "tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "lang": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "related": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "updated": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
          },
          "assets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "etag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha-256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        }
      }
    }
  }
}
