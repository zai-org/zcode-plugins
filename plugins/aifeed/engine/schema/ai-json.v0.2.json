{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifeed.md/schema/ai-json/v0.2.json",
  "title": "AIFeed Manifest v0.2",
  "type": "object",
  "required": [
    "version",
    "identity",
    "validity",
    "content",
    "permissions",
    "revocation",
    "metadata"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.2(\\.[0-9]+)?$"
    },
    "identity": {
      "type": "object",
      "required": [
        "domain",
        "name",
        "type",
        "locale",
        "contact",
        "public_key",
        "key_id",
        "signature_url"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "ecommerce",
            "news",
            "education",
            "government",
            "saas",
            "portfolio",
            "community",
            "docs",
            "nonprofit",
            "personal",
            "blog",
            "media",
            "marketplace",
            "other"
          ]
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-zA-Z]{0,7})?$"
        },
        "contact": {
          "type": "string",
          "pattern": "^(mailto:|https://)\\S+$",
          "maxLength": 512
        },
        "public_key": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9+/]{59}=$"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signature_url": {
          "type": "string",
          "pattern": "^/\\S+$",
          "maxLength": 512
        }
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "signed_at",
        "expires_at"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "signed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "languages"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "profile": {
          "enum": [
            "mako",
            "aifeed-md",
            "both"
          ]
        },
        "index_url": {
          "type": "string",
          "pattern": "^/\\S+$",
          "maxLength": 512
        },
        "llms_txt": {
          "type": "string",
          "pattern": "^/\\S+$"
        },
        "sitemap": {
          "type": "string",
          "pattern": "^/\\S+$"
        },
        "markdown": {
          "type": "object",
          "required": [
            "template"
          ],
          "additionalProperties": false,
          "properties": {
            "template": {
              "type": "string",
              "pattern": "\\{path\\}"
            },
            "link_relation": {
              "type": "boolean"
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          }
        },
        "license": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 128
            },
            "url": {
              "type": "string",
              "pattern": "^https://\\S+$"
            },
            "rsl_url": {
              "type": "string",
              "pattern": "^https://\\S+$"
            }
          }
        },
        "mako": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "index_url": {
              "type": "string",
              "pattern": "^/\\S+$",
              "maxLength": 512
            },
            "signature": {
              "enum": [
                "required",
                "optional"
              ]
            },
            "overrides": {
              "enum": [
                "restrict-only",
                "bidirectional"
              ]
            },
            "embedding": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "default",
        "usage",
        "attribution"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "default": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x_": {}
          },
          "properties": {
            "search": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "retrieval": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "input": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "training": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "quote": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "summarize": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "reproduce": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "translate": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "modify": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "embed": {
              "enum": [
                "allow",
                "deny"
              ]
            },
            "commercial_use": {
              "enum": [
                "allow",
                "deny"
              ]
            }
          }
        },
        "attribution": {
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "attribution_url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "attribution_text": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "concurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "crawl_delay_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "types": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "object",
                "array",
                "string",
                "integer",
                "boolean"
              ]
            },
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 100
            },
            "properties": {
              "type": "object",
              "maxProperties": 100
            },
            "items": {
              "type": "object"
            },
            "enum": {
              "type": "array",
              "maxItems": 100
            },
            "minimum": {
              "type": "integer"
            },
            "maximum": {
              "type": "integer"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            },
            "format": {
              "type": "string"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "actions": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "revocation": {
      "type": "object",
      "required": [
        "list_url",
        "maximum_check_interval_hours"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "list_url": {
          "type": "string",
          "pattern": "^https://aifeed\\.md/revoke/v1/"
        },
        "maximum_check_interval_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "successor_fp": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "predecessor_fp": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9_-]{43}$"
        },
        "effective_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "grace_until": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "supersedes_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "generated_at"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "generated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "generated_by": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "required": [
        "type",
        "required",
        "in"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "in": {
          "enum": [
            "query",
            "path",
            "body"
          ]
        },
        "default": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "enum": {
          "type": "array",
          "maxItems": 100
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "max_length": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "params": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/param"
        }
      }
    },
    "returns": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "array",
            "object"
          ]
        },
        "items_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "schema": {
          "type": "object"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "description",
        "endpoint",
        "method",
        "params",
        "returns",
        "auth_required"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "endpoint": {
          "type": "string",
          "pattern": "^/"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "returns": {
          "$ref": "#/$defs/returns"
        },
        "auth_required": {
          "type": "boolean"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "description",
        "endpoint",
        "method",
        "params",
        "returns",
        "requires_auth",
        "human_confirmation_required"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "endpoint": {
          "type": "string",
          "pattern": "^/"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "returns": {
          "$ref": "#/$defs/returns"
        },
        "requires_auth": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "none",
                "api_key",
                "oauth2"
              ]
            },
            "documentation_url": {
              "type": "string",
              "pattern": "^https://\\S+$"
            }
          }
        },
        "payment_terms_url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "human_confirmation_required": {
          "type": "boolean"
        },
        "requires_idempotency_key": {
          "type": "boolean"
        },
        "spending_limit": {
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      }
    }
  }
}
