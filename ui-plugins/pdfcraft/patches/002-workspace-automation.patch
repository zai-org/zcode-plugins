 fn font_extension(path: &Path) -> bool {
     path.extension().and_then(|e| e.to_str()).is_some_and(|e| e.eq_ignore_ascii_case("ttf") || e.eq_ignore_ascii_case("otf"))
 }
+
+#[cfg(target_arch = "wasm32")]
+pub fn discover(roots: &[PathBuf]) -> Vec<FontFile> {
+    let mut files=Vec::new(); let mut seen=std::collections::HashSet::new(); let mut budget=64usize << 20;
+    for root in roots.iter().take(16) {
+        for path in crate::craft_fs::list(&root.to_string_lossy()).unwrap_or_default() {
+            let path=PathBuf::from(path);
+            if !font_extension(&path) || !seen.insert(path.clone()) {continue;}
+            let Ok(bytes)=crate::craft_fs::read(&path) else {continue};
+            if bytes.len() > (16 << 20) || bytes.len()>budget {continue;}
+            budget-=bytes.len();
+            if pdfcraft_fonts::embedding::validate_document_input(&bytes).is_err() {continue;}
+            if let Ok((family,face))=pdfcraft_fonts::embedding::names(&bytes) {files.push(FontFile {path,family,face});}
+        }
+    }
+    files.sort_by(|a,b|a.face.cmp(&b.face).then(a.path.cmp(&b.path)));files
+}
