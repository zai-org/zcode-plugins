// 浏览器端到端测试：真实打包的 server + 官方 AppBridge 宿主 + 隔离 iframe 中的面板（读结构 → 调整 → 生成并自测）；
// 然后真正启动生成的管理后台，用 Chrome 以 editor / viewer / admin 三种角色操作：登录、搜索、筛选、排序、表单校验、唯一冲突、增改删、外键保护。需要 Chrome。
import assert from "node:assert/strict";
import { execFileSync, spawn } from "node:child_process";
import { mkdirSync } from "node:fs";
import { mkdtemp } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { startHarness } from "./harness.mjs";

const shots = process.env.E2E_SHOTS ?? join(tmpdir(), "db-admin-generator-shots");
mkdirSync(shots, { recursive: true });
const workspace = await mkdtemp(join(tmpdir(), "dbadm-e2e-"));
mkdirSync(join(workspace, "data"));
execFileSync(process.execPath, ["--no-warnings", process.env.DB_SAMPLE ?? "/workspace/zcode-new-plugins/samples/db/make-db.mjs", join(workspace, "data/harbor-bikes.db")]);
const harness = await startHarness({ workspace });
const step = (t: string) => process.stdout.write(`• ${t}\n`);
let admin: ReturnType<typeof spawn> | undefined;
try {
  const { outer, frame, context } = await harness.open("?locale=zh-CN", { width: 1440, height: 1000 });
  step("panel: read the schema, adjust, generate + self-test");
  await frame.locator("select.db").selectOption("data/harbor-bikes.db");
  await frame.locator("button.inspect").click();
  await frame.locator("tr[data-t='bikes']").waitFor({ timeout: 20_000 });
  assert.ok(await frame.locator("tr[data-t='open_rentals'] input[data-op='create']").isDisabled(), "views are read-only");
  await frame.locator("input.title").fill("Harbor Bikes 管理后台");
  await frame.locator("select.lang").selectOption("zh");
  for (const op of ["create", "update", "delete"]) await frame.locator(`tr[data-t='audit_log'] input[data-op='${op}']`).uncheck();
  await frame.locator("button.gen").click();
  await frame.locator(".done", { hasText: "全部通过" }).waitFor({ timeout: 120_000 });
  await frame.locator(".ck.ok", { hasText: "editor cannot delete" }).first().waitFor();
  assert.equal(await frame.locator(".ck.bad").count(), 0);
  await outer.screenshot({ path: join(shots, "01-panel.png") });

  step("start the generated admin with three users");
  const dir = join(workspace, "harbor-bikes-admin");
  const env = { ...process.env, NODE_NO_WARNINGS: "1", PORT: "0" };
  for (const [u, r] of [["eva", "editor"], ["vic", "viewer"], ["ada", "admin"]]) execFileSync(process.execPath, [join(dir, "server.mjs"), "user", "add", u, r], { env: { ...env, ADMIN_PASSWORD: `pw-${u}-12345` } });
  admin = spawn(process.execPath, [join(dir, "server.mjs")], { env, stdio: ["ignore", "pipe", "pipe"] });
  const base = await new Promise<string>((ok, fail) => { let out = ""; admin!.stdout!.on("data", (d) => { out += d; const m = /running at (http:\/\/\S+)/.exec(out); if (m) ok(m[1]); }); admin!.on("exit", (c) => fail(new Error(`admin exited ${c}`))); setTimeout(() => fail(new Error("admin start timeout")), 15_000); });
  const page = await context.newPage();
  const errs: string[] = [];
  page.on("pageerror", (e) => errs.push(String(e)));
  page.on("console", (m) => { if (m.type() === "error" && !/status of (400|401|403|409)/.test(m.text())) errs.push(m.text()); });
  page.on("dialog", (d) => void d.accept());
  await page.setViewportSize({ width: 1280, height: 800 });
  const login = async (u: string) => {
    await page.goto(base + "/");
    await page.locator("#user").fill(u);
    await page.locator("#pw").fill(`pw-${u}-12345`);
    await page.locator("button[type=submit]").click();
    await page.locator("aside .role").waitFor();
  };

  step("editor: wrong password, then sign in");
  await page.goto(base + "/");
  await page.locator("#user").fill("eva");
  await page.locator("#pw").fill("wrong-password");
  await page.locator("button[type=submit]").click();
  await page.locator(".login .err", { hasText: "用户名或密码不对" }).waitFor();
  await login("eva");
  await page.locator("aside a[data-t='bikes']").click();
  await page.locator("#count", { hasText: "/ 24" }).waitFor();
  step("search, filter, sort");
  await page.locator("#q").fill("Volt");
  await page.locator("#count", { hasText: "/ 6" }).waitFor();
  await page.locator("#q").fill("");
  await page.locator("select[data-f='category']").selectOption("kids");
  await page.locator("#count", { hasText: "/ 6" }).waitFor();
  await page.locator("tbody td", { hasText: "Kids bike" }).first().waitFor();
  await page.locator("select[data-f='category']").selectOption("");
  await page.locator("select[data-f='in_service']").selectOption("0");
  await page.locator("#count", { hasText: "/ 2" }).waitFor();
  await page.locator("select[data-f='in_service']").selectOption("");
  await page.locator("th[data-c='serial']").click();
  await page.locator("th[data-c='serial']").click();
  await page.locator("tbody tr").first().locator("td", { hasText: "HB-0024" }).waitFor();
  await page.screenshot({ path: join(shots, "02-admin-list.png") });

  step("editor: new bike — required errors, duplicate serial (409), then save");
  await page.locator("#new").click();
  assert.ok(await page.locator("#f_in_service").isChecked(), "column default (in_service = 1) prefilled");
  await page.locator("#dlg button[type=submit]").click();
  await page.locator("#dlg .err", { hasText: "必填" }).first().waitFor();
  assert.ok((await page.locator("#dlg .err", { hasText: "必填" }).count()) >= 3);
  await page.locator("#f_serial").fill("HB-0001");
  await page.locator("#f_model").fill("Volt Commuter");
  await page.locator("#f_category").selectOption("ebike");
  await page.locator("#f_frame_size").selectOption("M");
  await page.locator("#f_purchased_on").fill("2026-11-20");
  await page.locator("#dlg button[type=submit]").click();
  await page.locator("#dlg .err", { hasText: "已存在相同的值" }).waitFor();
  await page.screenshot({ path: join(shots, "03-form-validation.png") });
  await page.locator("#f_serial").fill("HB-0100");
  await page.locator("#dlg button[type=submit]").click();
  await page.locator("#count", { hasText: "/ 25" }).waitFor();
  step("editor: edit, and no delete button");
  await page.locator("tbody tr", { hasText: "HB-0100" }).click();
  await page.locator("#f_notes").fill("Demo fleet");
  assert.equal(await page.locator("#del").count(), 0, "editor has no delete");
  await page.locator("#dlg button[type=submit]").click();
  await page.locator("#dlg").waitFor({ state: "detached" });
  await page.locator("aside a[data-t='rentals']").click();
  await page.locator("tbody td .ref").first().waitFor();
  await page.locator("#logout").click();

  step("viewer: read-only");
  await login("vic");
  await page.locator("aside a[data-t='bikes']").click();
  await page.locator("#count", { hasText: "/ 25" }).waitFor();
  assert.equal(await page.locator("#new").count(), 0);
  await page.locator("tbody tr", { hasText: "HB-0100" }).click();
  await page.locator("#dlg #f_notes").waitFor();
  assert.equal(await page.locator("#dlg button[type=submit]").count(), 0);
  assert.equal(await page.locator("#f_notes").inputValue(), "Demo fleet");
  await page.screenshot({ path: join(shots, "04-viewer-readonly.png") });
  await page.locator("#cancel").click();
  await page.locator("#logout").click();

  step("admin: delete the new bike; deleting a category in use is refused");
  await login("ada");
  await page.locator("aside a[data-t='bikes']").click();
  await page.locator("tbody tr", { hasText: "HB-0100" }).click();
  await page.locator("#del").click();
  await page.locator("#count", { hasText: "/ 24" }).waitFor();
  await page.locator("aside a[data-t='categories']").click();
  await page.locator("tbody tr", { hasText: "kids" }).click();
  await page.locator("#del").click();
  await page.locator(".formerr", { hasText: "还有其他记录引用它" }).waitFor();
  await page.locator("#cancel").click();
  await page.locator("aside a[data-t='open_rentals']").click();
  await page.locator(".ro", { hasText: "只读视图" }).waitFor();
  assert.deepEqual(errs, [], "no script errors in the admin UI");
  assert.deepEqual(harness.errors, []);
  step(`ok — screenshots in ${shots}`);
} finally {
  admin?.kill();
  await harness.close();
}
