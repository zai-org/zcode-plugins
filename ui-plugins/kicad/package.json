    "test": "node test/static.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "esbuild": "0.25.12",
    "playwright-core": "1.59.1",
    "zod": "4.6.5"
  }
}
