{
  "name": "@penova/plugin-pdf-form-batch-fill",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node --experimental-strip-types scripts/e2e.mts"
  },
  "zcode": {
    "title": "PDF Form Batch Fill",
    "dirs": {
      "pdfjs-dist:cmaps": "pdfjs/cmaps",
      "pdfjs-dist:standard_fonts": "pdfjs/standard_fonts",
      "pdfjs-dist:wasm": "pdfjs/wasm"
    },
    "stub": [
      "unzipper"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "exceljs": "4.4.0",
    "fontkit": "2.0.4",
    "pdf-lib": "1.17.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@types/node": "25.5.0",
    "esbuild": "^0.25.12",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.59.1",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
