# Release output, UI source build intermediates and compiled install payloads
# are generated by `pnpm build`, in CI and locally. None of them is committed.
/dist/
/ui-plugins/**/dist/
/plugins/*/dist/
/external_plugins/*/dist/
__pycache__/
.DS_Store

# Written by scripts/sync_external_prs.py for the CI after_script; never committed.
mirror-failure.txt
mirror-result.txt
publish-failure.txt

# MCP App development dependencies and generated license intermediates.
node_modules/
ui-plugins/*/licenses/
*.tsbuildinfo

# Craft Web snapshots are compiled from the pinned upstream; caches are local.
/.craft-cache/
/ui-plugins/*/web/

# JetBrain IDE
.idea/*
